+
+/* Private live-dmenu transport used only by xhup-lookup. Queries and replies
+ * travel over an inherited socket, never a shell. GTK only renders the bounded
+ * results supplied by the backend. Reply IDs prevent stale results appearing. */
+static guint64 lookup_serial = 0;
+static GtkWidget* lookup_status = NULL;
+
+static void lookup_clear(void) {
+	previous_selection = NULL;
+	GList* children = gtk_container_get_children(GTK_CONTAINER(inner_box));
+	for(GList* it = children; it != NULL; it = it->next) {
+		previous_selection = NULL;
+		gtk_widget_destroy(GTK_WIDGET(it->data));
+	}
+	g_list_free(children);
+	line_count = 0;
+	user_moved = false;
+}
+
+static void lookup_changed(GtkEditable* editable, gpointer data) {
+	(void) editable;
+	(void) data;
+	free(filter);
+	filter = NULL;
+	lookup_clear();
+	gtk_label_set_text(GTK_LABEL(lookup_status), "查询中…");
+}
+
+static void lookup_query(void) {
+	gchar* encoded = g_base64_encode((const guchar*) filter, strlen(filter));
+	gchar* request = g_strdup_printf("%" G_GUINT64_FORMAT "\t%s\n", ++lookup_serial, encoded);
+	GError* error = NULL;
+	GIOStatus status = g_io_channel_write_chars(lookup_channel, request, -1, NULL, &error);
+	if(status == G_IO_STATUS_NORMAL) {
+		status = g_io_channel_flush(lookup_channel, &error);
+	}
+	g_free(encoded);
+	g_free(request);
+	if(status != G_IO_STATUS_NORMAL) {
+		g_printerr("xhup lookup transport: %s\n", error ? error->message : "write failed");
+		g_clear_error(&error);
+		wofi_exit(1);
+	}
+}
+
+static gboolean lookup_receive(GIOChannel* channel, GIOCondition condition, gpointer data) {
+	(void) data;
+	if(condition & (G_IO_ERR | G_IO_NVAL)) {
+		wofi_exit(1);
+	}
+	for(;;) {
+		gchar* packet = NULL;
+		GError* error = NULL;
+		GIOStatus status = g_io_channel_read_line(channel, &packet, NULL, NULL, &error);
+		if(status == G_IO_STATUS_AGAIN) {
+			return G_SOURCE_CONTINUE;
+		}
+		if(status != G_IO_STATUS_NORMAL) {
+			g_printerr("xhup lookup backend closed: %s\n", error ? error->message : "EOF");
+			g_clear_error(&error);
+			g_free(packet);
+			wofi_exit(1);
+		}
+		packet[strcspn(packet, "\r\n")] = '\0';
+		gchar** parts = g_strsplit(packet, "\t", 3);
+		if(g_strv_length(parts) == 3 &&
+			g_ascii_strtoull(parts[0], NULL, 10) == lookup_serial &&
+			g_strcmp0(filter, gtk_entry_get_text(GTK_ENTRY(entry))) == 0) {
+			gsize length;
+			guchar* raw = g_base64_decode(parts[2], &length);
+			gchar* text = g_strndup((const gchar*) raw, length);
+			gchar** rows = g_strsplit(text, "\n", -1);
+			lookup_clear();
+			for(guint i = 0; rows[i] != NULL && line_count < 200; ++i) {
+				gchar* label = strchr(rows[i], '\t');
+				if(label == NULL) continue;
+				*label++ = '\0';
+				GtkWidget* box = create_label("dmenu", label, label, rows[i]);
+				gtk_widget_set_halign(box, content_halign);
+				GtkWidget* child = gtk_flow_box_child_new();
+				gtk_widget_set_name(child, "entry");
+				gtk_container_add(GTK_CONTAINER(child), box);
+				gtk_container_add(GTK_CONTAINER(inner_box), child);
+				gtk_widget_show_all(child);
+				++line_count;
+			}
+			gchar* message = g_strdup_printf("显示 %u / %s 条 · 完全匹配优先，其次字词频 · 回车复制编码", line_count, parts[1]);
+			gtk_label_set_text(GTK_LABEL(lookup_status), message);
+			g_free(message);
+			GtkFlowBoxChild* first = gtk_flow_box_get_child_at_index(GTK_FLOW_BOX(inner_box), 0);
+			if(first != NULL) gtk_flow_box_select_child(GTK_FLOW_BOX(inner_box), first);
+			GtkAdjustment* adjustment = gtk_scrolled_window_get_vadjustment(GTK_SCROLLED_WINDOW(scroll));
+			gtk_adjustment_set_value(adjustment, 0);
+			g_strfreev(rows);
+			g_free(text);
+			g_free(raw);
+		}
+		g_strfreev(parts);
+		g_free(packet);
+	}
+}
+
+static void lookup_init(int fd) {
+	/* Copy helpers must not keep the backend socket alive after wofi exits. */
+	fcntl(fd, F_SETFD, FD_CLOEXEC);
+	pre_display_cmd = NULL;
+	previous_selection = NULL;
+	lookup_channel = g_io_channel_unix_new(fd);
+	g_io_channel_set_encoding(lookup_channel, NULL, NULL);
+	g_io_channel_set_flags(lookup_channel, G_IO_FLAG_NONBLOCK, NULL);
+	g_io_channel_set_close_on_unref(lookup_channel, TRUE);
+	gtk_flow_box_set_filter_func(GTK_FLOW_BOX(inner_box), NULL, NULL, NULL);
+	gtk_flow_box_set_sort_func(GTK_FLOW_BOX(inner_box), NULL, NULL, NULL);
+	lookup_status = gtk_label_new("查询中…");
+	gtk_widget_set_name(lookup_status, "lookup-status");
+	gtk_container_add(GTK_CONTAINER(outer_box), lookup_status);
+	g_signal_connect(entry, "changed", G_CALLBACK(lookup_changed), NULL);
+	g_io_add_watch(lookup_channel, G_IO_IN | G_IO_HUP | G_IO_ERR | G_IO_NVAL, lookup_receive, NULL);
 }
 
