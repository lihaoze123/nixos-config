+/* Niri supports data-control; GTK's focus-based clipboard does not work
+ * reliably for a background service. Keep GTK for other sessions. */
+static gboolean
+use_wl_clipboard (void)
+{
+  return g_strcmp0 (g_getenv ("VALENT_WL_CLIPBOARD"), "1") == 0;
+}
+
+static void
+wl_read_done (GSubprocess *process, GAsyncResult *result, gpointer user_data)
+{
+  g_autoptr (GTask) task = user_data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GBytes) output = NULL;
+
+  if (!g_subprocess_communicate_finish (process, result, &output, NULL, &error) ||
+      !g_subprocess_get_successful (process))
+    {
+      if (error == NULL)
+        error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_FAILED,
+                                     "Failed to read Wayland clipboard");
+      g_task_return_error (task, g_steal_pointer (&error));
+      return;
+    }
+  g_task_return_pointer (task, g_steal_pointer (&output),
+                         (GDestroyNotify)g_bytes_unref);
+}
+
+static void
+wl_write_done (GSubprocess *process, GAsyncResult *result, gpointer user_data)
+{
+  g_autoptr (GTask) task = user_data;
+  g_autoptr (GError) error = NULL;
+
+  if (!g_subprocess_communicate_finish (process, result, NULL, NULL, &error) ||
+      !g_subprocess_get_successful (process))
+    {
+      if (error == NULL)
+        error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_FAILED,
+                                     "Failed to write Wayland clipboard");
+      g_task_return_error (task, g_steal_pointer (&error));
+      return;
+    }
+  g_task_return_boolean (task, TRUE);
+}
+
